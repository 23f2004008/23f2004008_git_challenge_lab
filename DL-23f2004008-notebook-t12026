   "source": [
    "STEM_NAMES = ['bass.wav','drums.wav','other.wav','vocals.wav']\n",
    "\n",
    "def load_audio(fp, sr=SR, duration=DURATION, offset=0.0):\n",
    "    y, _ = librosa.load(str(fp), sr=sr, duration=duration, offset=offset)\n",
    "    t = int(sr*duration)\n",
    "    if len(y)==0: return np.zeros(t, dtype=np.float32)\n",
    "    if len(y)<t:  y = np.tile(y,(t//len(y))+1)[:t]\n",
    "    return y[:t].astype(np.float32)\n",
    "\n",
    "def mix_stems(folder, sr=SR, duration=DURATION, offset=0.0):\n",
    "    mixed = np.zeros(int(sr*duration), dtype=np.float32)\n",
    "    n = 0\n",
    "    for s in STEM_NAMES:\n",
    "        fp = Path(folder)/s\n",
    "        if fp.exists():\n",
    "            try: mixed += load_audio(fp, sr=sr, duration=duration, offset=offset); n+=1\n",
    "            except: pass\n",
    "    if n>0:\n",
    "        mx = np.abs(mixed).max()\n",
    "        if mx>0: mixed = mixed/mx*0.9\n",
    "    return mixed\n",
    "\n",
    "def compute_mel(y):\n",
    "    m = librosa.feature.melspectrogram(y=y,sr=SR,n_mels=N_MELS,\n",
    "                                        hop_length=HOP_LENGTH,n_fft=N_FFT,fmax=FMAX)\n",
    "    m = librosa.power_to_db(m, ref=np.max)\n",
    "    return ((m-m.mean())/(m.std()+1e-6)).astype(np.float32)\n",
    "\n",
    "def spec_augment(mel, fmask=20, tmask=80, n=2):\n",
    "    mel=mel.copy()\n",
    "    for _ in range(n):\n",
    "        f=random.randint(0,fmask); f0=random.randint(0,max(0,N_MELS-f))\n",
    "        mel[f0:f0+f,:]=0\n",
    "        t=random.randint(0,tmask); t0=random.randint(0,max(0,mel.shape[1]-t))\n",
    "        mel[:,t0:t0+t]=0\n",
    "    return mel\n",
    "\n",
    "def get_mel_train(folder):\n",
    "    key  = f\"{Path(folder).parent.name}_{Path(folder).name}\"\n",
    "    path = MEL_CACHE/f'{key}.npy'\n",
    "    if path.exists(): return np.load(path)\n",
    "    m = compute_mel(mix_stems(folder))\n",
    "    np.save(path, m); return m\n",
    "\n",
    "def get_mel_test(fp):\n",
    "    path = MEL_CACHE/f'test_{Path(fp).stem}.npy'\n",
    "    if path.exists(): return np.load(path)\n",
    "    m = compute_mel(load_audio(fp))\n",
    "    np.save(path, m); return m\n",
    "\n",
    "print('Utilities ready ✓')\n",
    "\n",
    "def mix_cross_genre(folder, label_idx, sr=22050, duration=10, offset=0.0):\n",
    "    \"\"\"Mix target song with alien stem from another genre (60% chance) to simulate mashup.\"\"\"\n",
    "    mixed = mix_stems(folder, sr=sr, duration=duration, offset=offset)\n",
    "    if random.random() < 0.6:\n",
    "        target_genre = GENRES[int(label_idx)]\n",
    "        other_genres = [g for g in GENRES if g != target_genre]\n",
    "        noise_genre  = random.choice(other_genres)\n",
    "        noise_folder = random.choice(genre_folder_map[noise_genre])\n",
    "        noise_stem   = random.choice(STEM_NAMES)\n",
    "        fp2 = Path(noise_folder) / noise_stem\n",
    "        if fp2.exists():\n",
    "            try:\n",
    "                noise = load_audio(fp2, sr=sr, duration=duration, offset=offset)\n",
    "                mixed = mixed + noise * random.uniform(0.3, 0.6)\n",
    "            except: pass\n",
    "    mx = np.abs(mixed).max()\n",
    "    if mx > 0: mixed = mixed / mx * 0.9\n",
    "    return mixed.astype(np.float32)\n"
   ]
