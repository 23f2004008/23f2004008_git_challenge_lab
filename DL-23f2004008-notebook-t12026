    "# ── Prior Correction — fix class bias ──\n",
    "# Problem: model over-predicts hiphop/reggae, under-predicts country\n",
    "# Fix: divide each class prob by its predicted frequency → forces balanced output\n",
    "\n",
    "raw_probs = ast_test.copy()  # shape (3020, 10)\n",
    "\n",
    "# Step 1: get predicted frequency per class\n",
    "pred_freq = raw_probs.mean(axis=0)  # how often each class is predicted on average\n",
    "print('Raw predicted frequencies:')\n",
    "for g, f in zip(GENRES, pred_freq):\n",
    "    print(f'  {g:12s}: {f:.4f}  (expected 0.1000)')\n",
    "\n",
    "# Step 2: divide by predicted frequency (prior correction)\n",
    "corrected = raw_probs / (pred_freq + 1e-8)\n",
    "\n",
    "# Step 3: renormalize\n",
    "corrected = corrected / corrected.sum(axis=1, keepdims=True)\n",
    "\n",
    "print('\\nCorrected predicted frequencies:')\n",
    "corrected_freq = corrected.mean(axis=0)\n",
