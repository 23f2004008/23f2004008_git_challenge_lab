type":"markdown","source":"## 6. CRNN — CNN + Bidirectional GRU","metadata":{}},{"id":"cfa5b02c-5023-4fa7-9cda-7e97ab57133f","cell_type":"code","source":"# Smaller CRNN — fits in remaining VRAM\nclass CRNN(nn.Module):\n    def __init__(self,nc=NUM_CLASSES,rh=128,dr=0.3):  # rh 256→128\n        super().__init__()\n        self.cnn=nn.Sequential(\n            nn.Conv2d(1,16,3,padding=1,bias=False),nn.BatchNorm2d(16),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(16,32,3,padding=1,bias=False),nn.BatchNorm2d(32),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(32,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(64,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)))\n        # after 4x MaxPool2d((2,2)): freq = 128//16 = 8\n        self.gru=nn.GRU(64*8,rh,1,batch_first=True,bidirectional=True,dropout=0.)\n        self.attn=nn.Linear(rh*2,1)\n        self.head=nn.Sequential(nn.Dropout(dr),nn.Linear(rh*2,nc))\n    def forward(self,x):\n        x=self.cnn(x)\n        B,C,H,W=x.shape\n        x=x.permute(0,3,1,2).reshape(B,W,C*H)\n        x,_=self.gru(x)\n        w=torch.softmax(self.attn(x),dim=1)\n        return self.head((x*w).sum(1))\n\n# verify it works\nwith torch.no_grad():\n    o=CRNN()(torch.randn(2,1,N_MELS,FIXED_FRAMES))\nprint(f'CRNN output:{o.shape}  Params:{sum(p.numel() for p in CRNN().parameters()):,}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-09T12:28:43.183801Z","iopub.execute_input":"2026-03-09T12:28:43.184139Z","iopub.status.idle":"2026-03-09T12:28:43.327267Z","shell.execute_reply.started":"2026-03-09T12:28:43.184108Z","shell.execute_reply":"2026-03-09T12:28:43.326145Z"}},"outputs":[{"name":"stdout","text":"CRNN output:torch.Size([2, 10])  Params:556,283\n","output_type":"stream"}],"execution_count":29},{"id":"10a36fae-01de-4790-a27e-93f0a9ebb521","cell_type":"code","source":"gc.collect()\ntorch.cuda.empty_cache()\ntorch.cuda.reset_peak_memory_s