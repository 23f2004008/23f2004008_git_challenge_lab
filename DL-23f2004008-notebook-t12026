    "class ASTTrainDs(Dataset):\n",
    "    \"\"\"Each song appears 3 times with different 10s offsets — covers all 30s.\"\"\"\n",
    "    def __init__(self, folders, labels):\n",
    "        self.items = []\n",
    "        for folder, label in zip(folders, labels):\n",
    "            for offset in TRAIN_OFFSETS:\n",
    "                self.items.append((folder, label, offset))\n",
    "    def __len__(self): return len(self.items)\n",
    "    def __getitem__(self, i):\n",
    "        folder, label, offset = self.items[i]\n",
    "        try:\n",
    "            y = mix_cross_genre(folder, label, sr=AST_SR, duration=SEG_DUR, offset=offset)\n",
    "        except:\n",
    "            y = np.zeros(int(AST_SR*SEG_DUR), dtype=np.float32)\n",
    "        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n",
    "        return {'input_values': inp['input_values'].squeeze(0),\n",
    "                'labels': torch.tensor(label, dtype=torch.long)}\n",
    "\n",
    "class ASTValDs(Dataset):\n",
    "    \"\"\"Validation — single segment per song.\"\"\"\n",
    "    def __init__(self, folders, labels):\n",
    "        self.folders = list(folders)\n",
    "        self.labels  = list(labels)\n",
    "    def __len__(self): return len(self.folders)\n",
    "    def __getitem__(self, i):\n",
    "        try:\n",
    "            y = mix_stems(self.folders[i], sr=AST_SR, duration=SEG_DUR, offset=0.0)\n",
    "        except:\n",
    "            y = np.zeros(int(AST_SR*SEG_DUR), dtype=np.float32)\n",
    "        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n",
    "        return {'input_values': inp['input_values'].squeeze(0),\n",
    "                'labels': torch.tensor(self.labels[i], dtype=torch.long)}\n",
    "\n",
    "class ASTTestDs(Dataset):\n",
    "    \"\"\"Test — one specific offset per call.\"\"\"\n",
    "    def __init__(self, fps, offset=0.0):\n",
    "        self.fps = list(fps)\n",
    "        self.offset = offset\n",
    "    def __len__(self): return len(self.fps)\n",
    "    def __getitem__(self, i):\n",
    "        try:\n",
    "            y = load_audio(self.fps[i], sr=AST_SR, duration=SEG_DUR, offset=self.offset)\n",
    "        except:\n",
    "            y = np.zeros(int(AST_SR*SEG_DUR), dtype=np.float32)\n",
    "        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n",
    "        return {'input_values': inp['input_values'].squeeze(0)}\n",
    "\n",
    "def ast_col(batch):\n",
    "    out = {'input_values': torch.stack([b['input_values'] for b in batch])}\n",
    "    if 'labels' in batch[0]:\n",
    "        out['labels'] = torch.tensor([b['labels'].item() for b in batch])\n",
    "    return out\n",
    "\n",
    "tr_fo,vl_fo,tr_lb,vl_lb = train_test_split(\n",
    "    folders_all, labs_all, test_size=0.2, stratify=labs_all, random_state=SEED)\n",
    "\n",
    "atrl = DataLoader(ASTTrainDs(tr_fo, tr_lb), AST_B, shuffle=True,  num_workers=2, collate_fn=ast_col)\n",
    "avll = DataLoader(ASTValDs(vl_fo,   vl_lb), AST_B, shuffle=False, num_workers=2, collate_fn=ast_col)\n",
    "print(f'Train batches: {len(atrl)}  Val batches: {len(avll)}')\n",
    "print('AST loaders ready ✓')"
