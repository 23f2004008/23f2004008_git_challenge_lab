    "def train_ep(model,loader,opt,crit):\n",
    "    model.train(); ls,ps,ts=0.,[],[]\n",
    "    for m,l in loader:\n",
    "        m,l=m.to(DEVICE),l.to(DEVICE)\n",
    "        opt.zero_grad(); o=model(m); loss=crit(o,l)\n",
    "        loss.backward()\n",
    "        torch.nn.utils.clip_grad_norm_(model.parameters(),1.0)\n",
    "        opt.step()\n",
    "        ls+=loss.item()*len(l)\n",
    "        ps.extend(o.detach().argmax(1).cpu().numpy())\n",
    "        ts.extend(l.cpu().numpy())\n",
    "    return ls/len(loader.dataset),f1_score(ts,ps,average='macro')\n",
    "\n",
    "@torch.no_grad()\n",
    "def val_ep(model,loader,crit):\n",
    "    model.eval(); ls,ps,ts,pr=0.,[],[],[]\n",
    "    for m,l in loader:\n",
    "        m,l=m.to(DEVICE),l.to(DEVICE); o=model(m)\n",
    "        ls+=crit(o,l).item()*len(l)\n",
    "        p=F.softmax(o,1).cpu().numpy()\n",
    "        pr.extend(p); ps.extend(p.argmax(1)); ts.extend(l.cpu().numpy())\n",
    "    return ls/len(loader.dataset),f1_score(ts,ps,average='macro'),np.array(pr)\n",
    "\n",
    "@torch.no_grad()\n",
    "def get_probs(model,loader):\n",
    "    model.eval(); out=[]\n",
    "    for b in loader:\n",
    "        m=(b[0] if isinstance(b,(list,tuple)) else b).to(DEVICE)\n",
    "        out.append(F.softmax(model(m),1).cpu().numpy())\n",
    "    return np.concatenate(out,0)\n",
