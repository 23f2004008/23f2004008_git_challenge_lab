{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.10.12"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":128431,"databundleVersionId":15477148}],"dockerImageVersionId":31259,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"39e590b5-7bd5-41c9-b0a5-ef13e0828475","cell_type":"markdown","source":"# 🎵 Messy Mashup — 23f2004008\n**EDA + Classical ML + CNN + CRNN + AST | Multi-segment TTA | Target 0.80+**","metadata":{}},{"id":"60b340e2-203b-471b-9fe9-ed2347b126f4","cell_type":"code","source":"!pip install -q librosa lightgbm transformers accelerate wandb","metadata":{},"outputs":[],"execution_count":null},{"id":"6e3e6ebf-8f92-436f-981a-dfc6a879b065","cell_type":"code","source":"import wandb\nfrom kaggle_secrets import UserSecretsClient\n\n# Login to W&B using Kaggle secret\ntry:\n    secrets = UserSecretsClient()\n    wandb_key = secrets.get_secret(\"WANDB_API_KEY\")\n    wandb.login(key=wandb_key)\n    print('✅ W&B login successful')\nexcept Exception as e:\n    print(f'Manual login needed: {e}')\n    wandb.login()  # will prompt for key\n\nWANDB_PROJECT = '23f2004008-t12026'\nprint(f'W&B project: {WANDB_PROJECT}')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"3f8bca10-bc9b-4489-9332-bc642ba2f8a0","cell_type":"code","source":"import os, random, warnings, gc, pickle\nimport numpy as np\nimport pandas as pd\nimport librosa\nimport librosa.display\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom pathlib import Path\nfrom tqdm.notebook import tqdm\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom sklearn.model_selection import StratifiedKFold, train_test_split\nfrom sklearn.metrics import f1_score, classification_report, confusion_matrix\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.pipeline import Pipeline\nimport lightgbm as lgb\n\nwarnings.filterwarnings('ignore')\nSEED = 42\nrandom.seed(SEED); np.random.seed(SEED)\ntorch.manual_seed(SEED); torch.cuda.manual_seed_all(SEED)\n\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f'Device: {DEVICE}')\nif torch.cuda.is_available():\n    print(f'GPU: {torch.cuda.get_device_name(0)}')","metadata":{},"outputs":[],"execution_count":null},{"id":"063e544c-0c05-4638-a9f0-f9ad8fdf2a9e","cell_type":"code","source":"BASE       = Path('/kaggle/input/jan-2026-dl-gen-ai-project/messy_mashup')\nTRAIN_DIR  = BASE / 'genres_stems'\nTEST_DIR   = BASE / 'mashups'\nSAMPLE_SUB = BASE / 'sample_submission.csv'\n\nSR         = 22050\nDURATION   = 30\nN_MELS     = 128\nHOP_LENGTH = 512\nN_FFT      = 2048\nFMAX       = 8000\nBATCH_SIZE = 32\nN_FOLDS    = 3\nEPOCHS_CNN = 30\nEPOCHS_AST = 12\nLR         = 3e-4\n\nGENRES = ['blues','classical','country','disco','hiphop',\n          'jazz','metal','pop','reggae','rock']\nNUM_CLASSES = len(GENRES)\nle = LabelEncoder()\nle.fit(GENRES)\n\nMEL_CACHE  = Path('/kaggle/working/mel_cache'); MEL_CACHE.mkdir(exist_ok=True)\nFEAT_CACHE = Path('/kaggle/working/ml_features.pkl')\n\nprint('Config ready ✓')\nprint(f'TRAIN: {TRAIN_DIR.exists()} | TEST: {TEST_DIR.exists()}')","metadata":{},"outputs":[],"execution_count":null},{"id":"d121cede-0b56-431f-9aab-c54588c0a9a9","cell_type":"markdown","source":"## 1. Load Data","metadata":{}},{"id":"832192ce-6cdf-46d2-9da8-942fb4fae5ea","cell_type":"code","source":"song_folders, song_labels = [], []\nfor genre in GENRES:\n    genre_dir = TRAIN_DIR / genre\n    if not genre_dir.exists(): print(f'MISSING: {genre}'); continue\n    folders = [d for d in genre_dir.iterdir() if d.is_dir()]\n    song_folders.extend(folders)\n    song_labels.extend([genre]*len(folders))\n    print(f'  {genre:12s}: {len(folders):4d} songs')\n\ndf_train = pd.DataFrame({'folder':song_folders,'genre':song_labels})\nprint(f'\\nTotal songs: {len(df_train)}')\n\ngenre_folder_map = {g: df_train[df_train['genre']==g]['folder'].tolist() for g in GENRES}","metadata":{},"outputs":[],"execution_count":null},{"id":"c210bb8c-b004-4891-9e57-0f62a27b8ef5","cell_type":"code","source":"sample_sub = pd.read_csv(SAMPLE_SUB)\nall_test   = sorted(TEST_DIR.glob('*.wav'))\nwav_map    = {int(f.stem.replace('song','')): f for f in all_test}\nsub_ids    = sample_sub.iloc[:,0].tolist()\ntest_files = [wav_map.get(int(sid), all_test[0]) for sid in sub_ids]\ntest_ids   = sub_ids\nprint(f'Test files  : {len(test_files)}')\nprint(f'First 5 IDs : {test_ids[:5]}')\nprint(f'First 5 wavs: {[f.name for f in test_files[:5]]}')","metadata":{},"outputs":[],"execution_count":null},{"id":"407c27bc-8d03-4eea-8323-848c35639fed","cell_type":"markdown","source":"## 2. Audio Utilities — Stem Mixing","metadata":{}},{"id":"61603bc0-1175-4b98-92ce-2f1c42dbe4b5","cell_type":"code","source":"STEM_NAMES = ['bass.wav','drums.wav','other.wav','vocals.wav']\n\ndef load_audio(fp, sr=SR, duration=DURATION, offset=0.0):\n    y, _ = librosa.load(str(fp), sr=sr, duration=duration, offset=offset)\n    t = int(sr*duration)\n    if len(y)==0: return np.zeros(t, dtype=np.float32)\n    if len(y)<t:  y = np.tile(y,(t//len(y))+1)[:t]\n    return y[:t].astype(np.float32)\n\ndef mix_stems(folder, sr=SR, duration=DURATION, offset=0.0):\n    mixed = np.zeros(int(sr*duration), dtype=np.float32)\n    n = 0\n    for s in STEM_NAMES:\n        fp = Path(folder)/s\n        if fp.exists():\n            try: mixed += load_audio(fp, sr=sr, duration=duration, offset=offset); n+=1\n            except: pass\n    if n>0:\n        mx = np.abs(mixed).max()\n        if mx>0: mixed = mixed/mx*0.9\n    return mixed\n\ndef compute_mel(y):\n    m = librosa.feature.melspectrogram(y=y,sr=SR,n_mels=N_MELS,\n                                        hop_length=HOP_LENGTH,n_fft=N_FFT,fmax=FMAX)\n    m = librosa.power_to_db(m, ref=np.max)\n    return ((m-m.mean())/(m.std()+1e-6)).astype(np.float32)\n\ndef spec_augment(mel, fmask=20, tmask=80, n=2):\n    mel=mel.copy()\n    for _ in range(n):\n        f=random.randint(0,fmask); f0=random.randint(0,max(0,N_MELS-f))\n        mel[f0:f0+f,:]=0\n        t=random.randint(0,tmask); t0=random.randint(0,max(0,mel.shape[1]-t))\n        mel[:,t0:t0+t]=0\n    return mel\n\ndef get_mel_train(folder):\n    key  = f\"{Path(folder).parent.name}_{Path(folder).name}\"\n    path = MEL_CACHE/f'{key}.npy'\n    if path.exists(): return np.load(path)\n    m = compute_mel(mix_stems(folder))\n    np.save(path, m); return m\n\ndef get_mel_test(fp):\n    path = MEL_CACHE/f'test_{Path(fp).stem}.npy'\n    if path.exists(): return np.load(path)\n    m = compute_mel(load_audio(fp))\n    np.save(path, m); return m\n\nprint('Utilities ready ✓')\n\ndef mix_cross_genre(folder, label_idx, sr=22050, duration=10, offset=0.0):\n    \"\"\"Always mix with 1-2 alien stems — closely matches test mashup audio.\"\"\"\n    mixed = mix_stems(folder, sr=sr, duration=duration, offset=offset)\n    n_alien = 2 if random.random() < 0.5 else 1\n    used = [GENRES[int(label_idx)]]\n    for _ in range(n_alien):\n        other = [g for g in GENRES if g not in used]\n        ng = random.choice(other); used.append(ng)\n        nf = random.choice(genre_folder_map[ng])\n        ns = random.choice(STEM_NAMES)\n        fp2 = Path(nf) / ns\n        if fp2.exists():\n            try:\n                noise = load_audio(fp2, sr=sr, duration=duration, offset=offset)\n                mixed = mixed + noise * random.uniform(0.3, 0.7)\n            except: pass\n    mx = np.abs(mixed).max()\n    if mx > 0: mixed = mixed / mx * 0.9\n    return mixed.astype(np.float32)\n","metadata":{},"outputs":[],"execution_count":null},{"id":"206a8439-72c9-4648-a922-bdfa14587b90","cell_type":"markdown","source":"## 2b. Build Synthetic Mashup Dataset","metadata":{}},{"id":"00a3fc98-0621-4c63-bf62-893b9188f85b","cell_type":"code","source":"# Build 5000-sample synthetic mashup dataset\n# Each sample = target song mixed with 1-2 alien stems\n# This pre-builds the dataset so training is faster and more reproducible\n\nMASHUP_DIR = Path('/kaggle/working/mashup_dataset')\nMASHUP_DIR.mkdir(exist_ok=True)\n\nN_MASHUPS_PER_SONG = 5  # 5 offsets x 1000 songs = 5000 samples\nMASHUP_OFFSETS = [0.0, 5.0, 10.0, 15.0, 20.0]\nAST_SR_BUILD = 16000\n\nmashup_records = []  # list of (filepath, label_idx)\n\nprint('Building synthetic mashup dataset...')\nprint(f'Target: {len(df_train) * N_MASHUPS_PER_SONG} mashup files')\n\nfor _, row in tqdm(df_train.iterrows(), total=len(df_train)):\n    folder   = row['folder']\n    label    = row['genre']\n    label_idx = le.transform([label])[0]\n    genre_key = Path(folder).parent.name\n    song_key  = Path(folder).name\n\n    for offset in MASHUP_OFFSETS:\n        fname = MASHUP_DIR / f'{genre_key}_{song_key}_off{int(offset)}.npy'\n        if not fname.exists():\n            try:\n                y = mix_cross_genre(folder, label_idx,\n                                    sr=AST_SR_BUILD, duration=10, offset=offset)\n                np.save(fname, y)\n            except Exception as e:\n                # fallback: zeros\n                np.save(fname, np.zeros(AST_SR_BUILD*10, dtype=np.float32))\n        mashup_records.append((str(fname), int(label_idx)))\n\ndf_mashup = pd.DataFrame(mashup_records, columns=['filepath','label'])\nprint(f'\\n✅ Mashup dataset built: {len(df_mashup)} samples')\nprint(df_mashup['label'].value_counts().sort_index().to_string())\nprint(f'Files saved to: {MASHUP_DIR}')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"fc808929-b6f6-42fb-9572-5d294af8f948","cell_type":"code","source":"print('Caching train mels...')\nfor folder in tqdm(df_train['folder']):\n    try: get_mel_train(folder)\n    except: pass\nprint('Caching test mels...')\nfor fp in tqdm(test_files):\n    try: get_mel_test(fp)\n    except: pass\nprint('All cached ✓')","metadata":{},"outputs":[],"execution_count":null},{"id":"288e362f-dd7e-43ae-a7ed-54e4ade5702d","cell_type":"markdown","source":"## 3. EDA","metadata":{}},{"id":"fda36980-aa00-4d53-8df5-355686296e20","cell_type":"code","source":"counts = df_train['genre'].value_counts()\npg,pc  = counts.index.tolist(),[int(v) for v in counts.values]\nfig,axes=plt.subplots(1,2,figsize=(14,5))\ncolors=plt.cm.tab10(np.linspace(0,1,len(pg)))\nbars=axes[0].bar(pg,pc,color=colors)\naxes[0].set_title('Songs per Genre',fontsize=13,fontweight='bold')\naxes[0].tick_params(axis='x',rotation=45)\nfor b,v in zip(bars,pc):\n    axes[0].text(b.get_x()+b.get_width()/2,b.get_height()+1,str(v),ha='center',fontsize=8)\naxes[1].pie(pc,labels=pg,autopct='%1.1f%%',startangle=90,colors=colors)\naxes[1].set_title('Class Share',fontsize=13,fontweight='bold')\nplt.tight_layout()\nplt.savefig('eda_class_dist.png',dpi=100,bbox_inches='tight')\nplt.show()\nprint(f'Total songs: {len(df_train)}')","metadata":{},"outputs":[],"execution_count":null},{"id":"db1ea404-7a76-45cb-a5f9-57ff859ba853","cell_type":"code","source":"fig,axes=plt.subplots(1,4,figsize=(20,4))\nfor col,genre in enumerate(['blues','classical','metal','hiphop']):\n    folder=df_train[df_train['genre']==genre]['folder'].iloc[0]\n    try:\n        mel=get_mel_train(folder)\n        librosa.display.specshow(mel,sr=SR,hop_length=HOP_LENGTH,\n                                  x_axis='time',y_axis='mel',ax=axes[col])\n        axes[col].set_title(f'{genre.upper()} — Mixed',fontweight='bold')\n    except: pass\nplt.suptitle('Mixed Stem Mel Spectrograms',fontsize=13,fontweight='bold')\nplt.tight_layout()\nplt.savefig('eda_features.png',dpi=100,bbox_inches='tight')\nplt.show()\nprint('EDA done ✓')","metadata":{},"outputs":[],"execution_count":null},{"id":"3854abc4-7aed-45ac-87da-8ef2ece169cc","cell_type":"markdown","source":"## 4. Classical ML","metadata":{}},{"id":"ca88b8a0-3f93-40b9-bb44-8822b1de38cc","cell_type":"code","source":"if FEAT_CACHE.exists():\n    with open(FEAT_CACHE,'rb') as f: X_ml,y_ml=pickle.load(f)\n    print('Loaded cached features')\nelse:\n    print('Building features...')\n    X_ml,y_ml=[],[]\n    for folder,label in tqdm(zip(df_train['folder'],df_train['genre']),total=len(df_train)):\n        try:\n            m=get_mel_train(folder)\n            X_ml.append(np.concatenate([m.mean(1),m.std(1),m.max(1),m.min(1)]))\n            y_ml.append(label)\n        except: pass\n    with open(FEAT_CACHE,'wb') as f: pickle.dump((X_ml,y_ml),f)\n\nX_ml=np.array(X_ml); y_ml_enc=le.transform(y_ml)\nprint(f'Feature matrix: {X_ml.shape}')","metadata":{},"outputs":[],"execution_count":null},{"id":"2371be12-fe26-4579-a231-d6d46d945fa1","cell_type":"code","source":"skf=StratifiedKFold(n_splits=N_FOLDS,shuffle=True,random_state=SEED)\nlgbm_oof=np.zeros((len(X_ml),NUM_CLASSES)); lgbm_models=[]\n\nfor fold,(tr,val) in enumerate(skf.split(X_ml,y_ml_enc)):\n    print(f'LGBM Fold {fold+1}...', end=' ',flush=True)\n    clf=lgb.LGBMClassifier(n_estimators=200,learning_rate=0.1,num_leaves=31,\n        max_depth=6,subsample=0.8,colsample_bytree=0.7,\n        class_weight='balanced',random_state=SEED+fold,verbose=-1,n_jobs=-1)\n    clf.fit(X_ml[tr],y_ml_enc[tr],eval_set=[(X_ml[val],y_ml_enc[val])],\n            callbacks=[lgb.early_stopping(30,verbose=False),lgb.log_evaluation(-1)])\n    probs=clf.predict_proba(X_ml[val])\n    lgbm_oof[val]=probs; lgbm_models.append(clf)\n    print(f'F1={f1_score(y_ml_enc[val],probs.argmax(1),average=\"macro\"):.4f}')\n\nlgbm_oof_f1=f1_score(y_ml_enc,lgbm_oof.argmax(1),average='macro')\nprint(f'\\n✅ LGBM OOF F1: {lgbm_oof_f1:.4f}')","metadata":{},"outputs":[],"execution_count":null},{"id":"f18eac09-2566-4b96-824b-1a221db400ae","cell_type":"code","source":"lr_oof=np.zeros((len(X_ml),NUM_CLASSES))\nfor fold,(tr,val) in enumerate(skf.split(X_ml,y_ml_enc)):\n    pipe=Pipeline([('sc',StandardScaler()),\n                   ('clf',LogisticRegression(C=1.0,max_iter=300,class_weight='balanced',\n                                             solver='saga',n_jobs=-1,random_state=SEED))])\n    pipe.fit(X_ml[tr],y_ml_enc[tr])\n    probs=pipe.predict_proba(X_ml[val])\n    lr_oof[val]=probs\n    print(f'LogReg Fold {fold+1} F1={f1_score(y_ml_enc[val],probs.argmax(1),average=\"macro\"):.4f}')\n\nlr_oof_f1=f1_score(y_ml_enc,lr_oof.argmax(1),average='macro')\nprint(f'\\n✅ LogReg OOF F1: {lr_oof_f1:.4f}')","metadata":{},"outputs":[],"execution_count":null},{"id":"11777e6b-95ff-4069-b67c-614095a8b135","cell_type":"code","source":"X_test_ml=[]\nfor fp in tqdm(test_files,desc='Test features'):\n    try:\n        m=get_mel_test(fp)\n        X_test_ml.append(np.concatenate([m.mean(1),m.std(1),m.max(1),m.min(1)]))\n    except: X_test_ml.append(np.zeros(X_ml.shape[1],dtype=np.float32))\n\nX_test_ml=np.array(X_test_ml)\nlgbm_test_probs=np.mean([m.predict_proba(X_test_ml) for m in lgbm_models],axis=0)\npd.DataFrame({'id':test_ids,'genre':le.inverse_transform(lgbm_test_probs.argmax(1))}).to_csv('submission_lgbm.csv',index=False)\nprint('✓ submission_lgbm.csv')","metadata":{},"outputs":[],"execution_count":null},{"id":"3a00b809-14e9-4c09-ab8f-8768d06ca790","cell_type":"markdown","source":"## 5. CNN from Scratch","metadata":{}},{"id":"cf9b7785-9d99-458f-bd4d-fc1490f4dff8","cell_type":"code","source":"FIXED_FRAMES=int(SR*DURATION/HOP_LENGTH)+1\n\nclass MelDataset(Dataset):\n    def __init__(self,folders,labels=None,augment=False):\n        self.folders=list(folders); self.labels=labels; self.augment=augment\n    def __len__(self): return len(self.folders)\n    def _fix(self,m):\n        T=m.shape[1]\n        if T<FIXED_FRAMES: m=np.pad(m,((0,0),(0,FIXED_FRAMES-T)),mode='wrap')\n        elif T>FIXED_FRAMES:\n            s=random.randint(0,T-FIXED_FRAMES) if self.augment else (T-FIXED_FRAMES)//2\n            m=m[:,s:s+FIXED_FRAMES]\n        return m\n    def __getitem__(self,i):\n        try: m=get_mel_train(self.folders[i])\n        except: m=np.zeros((N_MELS,FIXED_FRAMES),dtype=np.float32)\n        m=self._fix(m)\n        if self.augment: m=spec_augment(m)\n        m=torch.tensor(m,dtype=torch.float32).unsqueeze(0)\n        if self.labels is not None:\n            return m,torch.tensor(self.labels[i],dtype=torch.long)\n        return m\n\nclass TestMelDataset(Dataset):\n    def __init__(self,fps):\n        self.fps=list(fps)\n    def __len__(self): return len(self.fps)\n    def _fix(self,m):\n        T=m.shape[1]\n        if T<FIXED_FRAMES: m=np.pad(m,((0,0),(0,FIXED_FRAMES-T)),mode='wrap')\n        elif T>FIXED_FRAMES: m=m[:,(T-FIXED_FRAMES)//2:(T-FIXED_FRAMES)//2+FIXED_FRAMES]\n        return m\n    def __getitem__(self,i):\n        try: m=get_mel_test(self.fps[i])\n        except: m=np.zeros((N_MELS,FIXED_FRAMES),dtype=np.float32)\n        return torch.tensor(self._fix(m),dtype=torch.float32).unsqueeze(0)\n\nclass ResBlock(nn.Module):\n    def __init__(self,ic,oc,s=1):\n        super().__init__()\n        self.c=nn.Sequential(\n            nn.Conv2d(ic,oc,3,stride=s,padding=1,bias=False),nn.BatchNorm2d(oc),nn.ReLU(True),\n            nn.Conv2d(oc,oc,3,padding=1,bias=False),nn.BatchNorm2d(oc))\n        self.sk=nn.Sequential() if (s==1 and ic==oc) else nn.Sequential(\n            nn.Conv2d(ic,oc,1,stride=s,bias=False),nn.BatchNorm2d(oc))\n        self.r=nn.ReLU(True)\n    def forward(self,x): return self.r(self.c(x)+self.sk(x))\n\nclass MelCNN(nn.Module):\n    def __init__(self,nc=NUM_CLASSES,dr=0.4):\n        super().__init__()\n        self.net=nn.Sequential(\n            nn.Conv2d(1,32,7,stride=2,padding=3,bias=False),nn.BatchNorm2d(32),nn.ReLU(True),\n            nn.MaxPool2d(3,stride=2,padding=1),\n            ResBlock(32,64),ResBlock(64,64),\n            ResBlock(64,128,2),ResBlock(128,128),\n            ResBlock(128,256,2),ResBlock(256,256),\n            ResBlock(256,512,2),ResBlock(512,512),\n            nn.AdaptiveAvgPool2d((1,1)))\n        self.head=nn.Sequential(\n            nn.Flatten(),nn.Dropout(dr),\n            nn.Linear(512,256),nn.ReLU(True),\n            nn.Dropout(dr*0.5),nn.Linear(256,nc))\n    def forward(self,x): return self.head(self.net(x))\n\nwith torch.no_grad():\n    o=MelCNN()(torch.randn(2,1,N_MELS,FIXED_FRAMES))\nprint(f'CNN output:{o.shape}  Params:{sum(p.numel() for p in MelCNN().parameters()):,}')","metadata":{},"outputs":[],"execution_count":null},{"id":"8468bf97-bb61-4e48-84b8-c657e3d57f24","cell_type":"code","source":"def train_ep(model,loader,opt,crit):\n    model.train(); ls,ps,ts=0.,[],[]\n    for m,l in loader:\n        m,l=m.to(DEVICE),l.to(DEVICE)\n        opt.zero_grad(); o=model(m); loss=crit(o,l)\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(),1.0)\n        opt.step()\n        ls+=loss.item()*len(l)\n        ps.extend(o.detach().argmax(1).cpu().numpy())\n        ts.extend(l.cpu().numpy())\n    return ls/len(loader.dataset),f1_score(ts,ps,average='macro')\n\n@torch.no_grad()\ndef val_ep(model,loader,crit):\n    model.eval(); ls,ps,ts,pr=0.,[],[],[]\n    for m,l in loader:\n        m,l=m.to(DEVICE),l.to(DEVICE); o=model(m)\n        ls+=crit(o,l).item()*len(l)\n        p=F.softmax(o,1).cpu().numpy()\n        pr.extend(p); ps.extend(p.argmax(1)); ts.extend(l.cpu().numpy())\n    return ls/len(loader.dataset),f1_score(ts,ps,average='macro'),np.array(pr)\n\n@torch.no_grad()\ndef get_probs(model,loader):\n    model.eval(); out=[]\n    for b in loader:\n        m=(b[0] if isinstance(b,(list,tuple)) else b).to(DEVICE)\n        out.append(F.softmax(model(m),1).cpu().numpy())\n    return np.concatenate(out,0)\n\nprint('Helpers ready ✓')","metadata":{},"outputs":[],"execution_count":null},{"id":"21b951a2-8a72-4731-bf59-05524aa044a7","cell_type":"code","source":"folders_all=df_train['folder'].values\nlabs_all=le.transform(df_train['genre'].values)\nskf=StratifiedKFold(n_splits=N_FOLDS,shuffle=True,random_state=SEED)\ncnn_oof=np.zeros((len(folders_all),NUM_CLASSES))\ncnn_test=np.zeros((len(test_files),NUM_CLASSES))\ncnn_fold_scores=[]\n\nrun_cnn = wandb.init(project=WANDB_PROJECT, name='CNN-from-scratch', reinit=True,\n    config={'model':'MelCNN','epochs':EPOCHS_CNN,'batch_size':BATCH_SIZE,\n            'lr':LR,'n_folds':N_FOLDS,'n_mels':N_MELS,'optimizer':'AdamW'})\n\nfor fold,(tri,vali) in enumerate(skf.split(folders_all,labs_all)):\n    print(f'\\n━━━ CNN Fold {fold+1}/{N_FOLDS} ━━━')\n    gc.collect(); torch.cuda.empty_cache()\n    trl=DataLoader(MelDataset(folders_all[tri],labs_all[tri],True),BATCH_SIZE,shuffle=True,num_workers=2,pin_memory=True)\n    vll=DataLoader(MelDataset(folders_all[vali],labs_all[vali],False),BATCH_SIZE,shuffle=False,num_workers=2,pin_memory=True)\n    tsl=DataLoader(TestMelDataset(test_files),BATCH_SIZE,shuffle=False,num_workers=2)\n    model=MelCNN().to(DEVICE)\n    opt=torch.optim.AdamW(model.parameters(),lr=LR,weight_decay=1e-4)\n    sch=torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(opt,T_0=10,T_mult=2)\n    crit=nn.CrossEntropyLoss(label_smoothing=0.1)\n    best_f1,best_st,pat=0.,None,0\n    for ep in range(EPOCHS_CNN):\n        tl,tf=train_ep(model,trl,opt,crit)\n        vl,vf,_=val_ep(model,vll,crit)\n        sch.step()\n        wandb.log({'cnn/epoch':ep+1,'cnn/fold':fold+1,\n                   'cnn/train_loss':tl,'cnn/val_loss':vl,\n                   'cnn/train_f1':tf,'cnn/val_f1':vf})\n        if vf>best_f1: best_f1=vf; best_st={k:v.cpu().clone() for k,v in model.state_dict().items()}; pat=0\n        else: pat+=1\n        if (ep+1)%5==0: print(f'  ep{ep+1}: tf={tf:.3f} vf={vf:.3f} best={best_f1:.3f}')\n        if pat>=8: print(f'  early stop ep{ep+1}'); break\n    model.load_state_dict(best_st); model.to(DEVICE)\n    _,_,pr=val_ep(model,vll,crit)\n    cnn_oof[vali]=pr; cnn_test+=get_probs(model,tsl)/N_FOLDS\n    cnn_fold_scores.append(best_f1)\n    print(f'  ✓ Fold {fold+1} best F1: {best_f1:.4f}')\n    del model; gc.collect(); torch.cuda.empty_cache()\n\ncnn_oof_f1=f1_score(labs_all,cnn_oof.argmax(1),average='macro')\nprint(f'\\n✅ CNN OOF F1: {cnn_oof_f1:.4f}  Folds:{[f\"{s:.3f}\" for s in cnn_fold_scores]}')\nwandb.log({'cnn/oof_f1':cnn_oof_f1})\nrun_cnn.finish()\nprint('✓ CNN W&B run finished')\npd.DataFrame({'id':test_ids,'genre':le.inverse_transform(cnn_test.argmax(1))}).to_csv('submission_cnn.csv',index=False)\nprint('✓ submission_cnn.csv')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"23383e99-b35f-4fe2-b7b7-f6c1c73d6723","cell_type":"markdown","source":"## 6. CRNN","metadata":{}},{"id":"c2640cdd-f747-43bc-8f9d-858468c3e658","cell_type":"code","source":"class CRNN(nn.Module):\n    def __init__(self,nc=NUM_CLASSES,rh=128,dr=0.3):\n        super().__init__()\n        self.cnn=nn.Sequential(\n            nn.Conv2d(1,16,3,padding=1,bias=False),nn.BatchNorm2d(16),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(16,32,3,padding=1,bias=False),nn.BatchNorm2d(32),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(32,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)),\n            nn.Conv2d(64,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)))\n        self.gru=nn.GRU(64*(N_MELS//16),rh,1,batch_first=True,bidirectional=True,dropout=0.)\n        self.attn=nn.Linear(rh*2,1)\n        self.head=nn.Sequential(nn.Dropout(dr),nn.Linear(rh*2,nc))\n    def forward(self,x):\n        x=self.cnn(x); B,C,H,W=x.shape\n        x=x.permute(0,3,1,2).reshape(B,W,C*H)\n        x,_=self.gru(x)\n        w=torch.softmax(self.attn(x),dim=1)\n        return self.head((x*w).sum(1))\n\nwith torch.no_grad():\n    o=CRNN()(torch.randn(2,1,N_MELS,FIXED_FRAMES))\nprint(f'CRNN output:{o.shape}  Params:{sum(p.numel() for p in CRNN().parameters()):,}')","metadata":{},"outputs":[],"execution_count":null},{"id":"7533f31e-7e13-49b4-9daa-6e1356109984","cell_type":"code","source":"gc.collect(); torch.cuda.empty_cache()\ncrnn_oof=np.zeros((len(folders_all),NUM_CLASSES))\ncrnn_test=np.zeros((len(test_files),NUM_CLASSES))\ncrnn_fold_scores=[]\n\nrun_crnn = wandb.init(project=WANDB_PROJECT, name='CRNN-sequential', reinit=True,\n    config={'model':'CRNN','epochs':25,'batch_size':16,\n            'lr':LR*0.7,'n_folds':N_FOLDS,'rnn':'BiGRU','hidden':128})\n\nfor fold,(tri,vali) in enumerate(skf.split(folders_all,labs_all)):\n    print(f'\\n━━━ CRNN Fold {fold+1}/{N_FOLDS} ━━━')\n    gc.collect(); torch.cuda.empty_cache()\n    trl=DataLoader(MelDataset(folders_all[tri],labs_all[tri],True),16,shuffle=True,num_workers=2,pin_memory=True)\n    vll=DataLoader(MelDataset(folders_all[vali],labs_all[vali],False),16,shuffle=False,num_workers=2,pin_memory=True)\n    tsl=DataLoader(TestMelDataset(test_files),16,shuffle=False,num_workers=2)\n    model=CRNN().to(DEVICE)\n    opt=torch.optim.AdamW(model.parameters(),lr=LR*0.7,weight_decay=1e-4)\n    sch=torch.optim.lr_scheduler.CosineAnnealingLR(opt,T_max=25)\n    crit=nn.CrossEntropyLoss(label_smoothing=0.1)\n    best_f1,best_st,pat=0.,None,0\n    for ep in range(25):\n        tl,tf=train_ep(model,trl,opt,crit)\n        vl,vf,_=val_ep(model,vll,crit)\n        sch.step()\n        wandb.log({'crnn/epoch':ep+1,'crnn/fold':fold+1,\n                   'crnn/train_loss':tl,'crnn/val_loss':vl,\n                   'crnn/train_f1':tf,'crnn/val_f1':vf})\n        if vf>best_f1: best_f1=vf; best_st={k:v.cpu().clone() for k,v in model.state_dict().items()}; pat=0\n        else: pat+=1\n        if (ep+1)%5==0: print(f'  ep{ep+1}: tf={tf:.3f} vf={vf:.3f} best={best_f1:.3f}')\n        if pat>=8: print(f'  early stop ep{ep+1}'); break\n    model.load_state_dict(best_st); model.to(DEVICE)\n    _,_,pr=val_ep(model,vll,crit)\n    crnn_oof[vali]=pr; crnn_test+=get_probs(model,tsl)/N_FOLDS\n    crnn_fold_scores.append(best_f1)\n    print(f'  ✓ Fold {fold+1} best F1: {best_f1:.4f}')\n    del model; gc.collect(); torch.cuda.empty_cache()\n\ncrnn_oof_f1=f1_score(labs_all,crnn_oof.argmax(1),average='macro')\nprint(f'\\n✅ CRNN OOF F1: {crnn_oof_f1:.4f}  Folds:{[f\"{s:.3f}\" for s in crnn_fold_scores]}')\nwandb.log({'crnn/oof_f1':crnn_oof_f1})\nrun_crnn.finish()\nprint('✓ CRNN W&B run finished')\npd.DataFrame({'id':test_ids,'genre':le.inverse_transform(crnn_test.argmax(1))}).to_csv('submission_crnn.csv',index=False)\nprint('✓ submission_crnn.csv')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"dcca1c5d-6ae6-4018-bd6c-42bc1dd7a9b1","cell_type":"markdown","source":"## 7. AST Transformer — Multi-segment Training + TTA","metadata":{}},{"id":"e1782f7d-2f7e-43d4-9bd6-2688a5f07655","cell_type":"code","source":"from transformers import ASTFeatureExtractor, ASTForAudioClassification\ngc.collect(); torch.cuda.empty_cache()\n\nAST_CKPT      = 'MIT/ast-finetuned-audioset-10-10-0.4593'\nAST_SR        = 16000\nAST_B         = 12\nSEG_DUR       = 10\nEPOCHS_AST    = 15\nTRAIN_OFFSETS = [0.0, 5.0, 10.0, 15.0, 20.0]\nTEST_OFFSETS  = [0.0, 5.0, 10.0, 15.0, 20.0]\n\nfe  = ASTFeatureExtractor.from_pretrained(AST_CKPT)\nast = ASTForAudioClassification.from_pretrained(\n    AST_CKPT, num_labels=NUM_CLASSES,\n    id2label={i:g for i,g in enumerate(GENRES)},\n    label2id={g:i for i,g in enumerate(GENRES)},\n    ignore_mismatched_sizes=True).to(DEVICE)\nprint(f'AST loaded ✓  Params:{sum(p.numel() for p in ast.parameters()):,}')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"c3ab438d-ff52-4e9f-9314-b2b740359eb7","cell_type":"code","source":"class ASTMashupDs(Dataset):\n    def __init__(self, records):\n        self.records = records\n    def __len__(self): return len(self.records)\n    def __getitem__(self, i):\n        fp, label = self.records[i]\n        try: y = np.load(fp)\n        except: y = np.zeros(AST_SR*SEG_DUR, dtype=np.float32)\n        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n        return {'input_values': inp['input_values'].squeeze(0),\n                'labels': torch.tensor(label, dtype=torch.long)}\n\nclass ASTValDs(Dataset):\n    def __init__(self, folders, labels):\n        self.folders = list(folders); self.labels = list(labels)\n    def __len__(self): return len(self.folders)\n    def __getitem__(self, i):\n        try:\n            y = mix_cross_genre(self.folders[i], self.labels[i],\n                                sr=AST_SR, duration=SEG_DUR, offset=0.0)\n        except: y = np.zeros(int(AST_SR*SEG_DUR), dtype=np.float32)\n        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n        return {'input_values': inp['input_values'].squeeze(0),\n                'labels': torch.tensor(self.labels[i], dtype=torch.long)}\n\nclass ASTTestDs(Dataset):\n    def __init__(self, fps, offset=0.0):\n        self.fps = list(fps); self.offset = offset\n    def __len__(self): return len(self.fps)\n    def __getitem__(self, i):\n        try: y = load_audio(self.fps[i], sr=AST_SR, duration=SEG_DUR, offset=self.offset)\n        except: y = np.zeros(int(AST_SR*SEG_DUR), dtype=np.float32)\n        inp = fe(y, sampling_rate=AST_SR, return_tensors='pt', padding='max_length')\n        return {'input_values': inp['input_values'].squeeze(0)}\n\ndef ast_col(batch):\n    out = {'input_values': torch.stack([b['input_values'] for b in batch])}\n    if 'labels' in batch[0]:\n        out['labels'] = torch.tensor([b['labels'].item() for b in batch])\n    return out\n\n# All 5000 for training\nall_records = list(zip(df_mashup['filepath'], df_mashup['label']))\n\n# Proper holdout: last 15 songs per class for val only\nval_folders, val_labels = [], []\nfor gi, genre in enumerate(GENRES):\n    genre_folders = df_train[df_train['genre']==genre]['folder'].tolist()\n    for f in genre_folders[-15:]:\n        val_folders.append(f)\n        val_labels.append(gi)\n\nfull_atrl = DataLoader(ASTMashupDs(all_records), AST_B,\n                       shuffle=True, num_workers=2, collate_fn=ast_col)\navll      = DataLoader(ASTValDs(val_folders, val_labels),\n                       AST_B, shuffle=False, num_workers=2, collate_fn=ast_col)\n\nprint(f'Train: {len(full_atrl.dataset)} mashup samples')\nprint(f'Val: {len(val_folders)} samples (15 per class, honest holdout)')\nprint('AST loaders ready ✓')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"377e7fc0-81cf-473b-b35a-e9d37e6a5780","cell_type":"code","source":"run_ast = wandb.init(project=WANDB_PROJECT, name='AST-pretrained-finetune', reinit=True,\n    config={'model':'AST','checkpoint':'MIT/ast-finetuned-audioset-10-10-0.4593',\n            'epochs':EPOCHS_AST,'batch_size':AST_B,'seg_dur':SEG_DUR,\n            'backbone_lr':2e-5,'head_lr':1e-4,'label_smoothing':0.05,\n            'train_samples':len(full_atrl.dataset),\n            'test_offsets':len(TEST_OFFSETS),'val_samples':len(val_folders)})\n\nfor n, p in ast.named_parameters():\n    p.requires_grad = ('classifier' in n or 'layernorm' in n)\n\ncrit_ast = nn.CrossEntropyLoss(label_smoothing=0.05)\nscaler   = torch.cuda.amp.GradScaler()\nopt_ast  = torch.optim.AdamW(\n    filter(lambda p: p.requires_grad, ast.parameters()), lr=1e-4, weight_decay=1e-4)\n\nbest_af, best_ast_st = 0., None\n# Save checkpoints at ep10, ep15, ep20 for multi-checkpoint ensemble\nsaved_checkpoints = {}\nSAVE_AT = {10, 15}\n\nfor ep in range(EPOCHS_AST):\n    if ep == 3:\n        print('🔓 Unfreezing all layers...')\n        for p in ast.parameters(): p.requires_grad = True\n        opt_ast = torch.optim.AdamW([\n            {'params': ast.audio_spectrogram_transformer.parameters(), 'lr': 2e-5},\n            {'params': ast.classifier.parameters(), 'lr': 1e-4}\n        ], weight_decay=1e-4)\n        scaler = torch.cuda.amp.GradScaler()\n\n    ast.train(); tp, tt = [], []\n    for b in tqdm(full_atrl, desc=f'AST ep{ep+1}', leave=False):\n        iv = b['input_values'].to(DEVICE)\n        lb = b['labels'].to(DEVICE)\n        opt_ast.zero_grad()\n        with torch.cuda.amp.autocast():\n            logits = ast(input_values=iv).logits\n            loss = crit_ast(logits, lb)\n        scaler.scale(loss).backward()\n        scaler.unscale_(opt_ast)\n        torch.nn.utils.clip_grad_norm_(ast.parameters(), 1.0)\n        scaler.step(opt_ast); scaler.update()\n        tp.extend(logits.detach().argmax(1).cpu().numpy())\n        tt.extend(lb.cpu().numpy())\n    tf = f1_score(tt, tp, average='macro')\n\n    ast.eval(); vp, vt = [], []\n    with torch.no_grad():\n        for b in avll:\n            iv = b['input_values'].to(DEVICE)\n            vp.extend(ast(input_values=iv).logits.argmax(1).cpu().numpy())\n            vt.extend(b['labels'].numpy())\n    vf = f1_score(vt, vp, average='macro')\n    print(f'ep{ep+1}: train_f1={tf:.4f}  val_f1={vf:.4f}')\n    wandb.log({'ast/epoch':ep+1, 'ast/train_f1':tf, 'ast/val_f1':vf})\n\n    if vf > best_af:\n        best_af = vf\n        best_ast_st = {k: v.cpu().clone() for k, v in ast.state_dict().items()}\n        print(f'  ✓ New best: {best_af:.4f}')\n\n    # Save snapshots at ep10, ep15, ep20 for ensemble\n    if (ep+1) in SAVE_AT:\n        saved_checkpoints[ep+1] = {k: v.cpu().clone() for k, v in ast.state_dict().items()}\n        print(f'  📸 Checkpoint saved at ep{ep+1}')\n\nwandb.log({'ast/best_val_f1': best_af})\nrun_ast.finish()\nprint(f'\\n✅ Best AST val F1: {best_af:.4f}')\nprint(f'Saved checkpoints: {list(saved_checkpoints.keys())}')\nprint('✓ AST W&B run finished')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"afcb1a2c-d172-4119-bb6a-590bd40fb616","cell_type":"code","source":"# Multi-checkpoint ensemble: best_val + ep10 + ep15 + ep20\n# Each checkpoint sees the data differently — free ensemble boost\ncheckpoints_to_use = {}\ncheckpoints_to_use['best_val'] = best_ast_st\ncheckpoints_to_use.update(saved_checkpoints)\n\nprint(f'Ensembling {len(checkpoints_to_use)} checkpoints: {list(checkpoints_to_use.keys())}')\n\nast_test = np.zeros((len(test_files), NUM_CLASSES))\n\nfor ckpt_name, ckpt_state in checkpoints_to_use.items():\n    ast.load_state_dict(ckpt_state); ast.to(DEVICE).eval()\n    ckpt_preds = np.zeros((len(test_files), NUM_CLASSES))\n    for offset in TEST_OFFSETS:\n        loader = DataLoader(ASTTestDs(test_files, offset=offset),\n                            AST_B, shuffle=False, num_workers=2, collate_fn=ast_col)\n        pr = []\n        with torch.no_grad():\n            for b in tqdm(loader, desc=f'{ckpt_name} offset={offset:.0f}s', leave=False):\n                iv = b['input_values'].to(DEVICE)\n                pr.append(F.softmax(ast(input_values=iv).logits, 1).cpu().numpy())\n        ckpt_preds += np.concatenate(pr, 0) / len(TEST_OFFSETS)\n    ast_test += ckpt_preds / len(checkpoints_to_use)\n    print(f'  ✓ {ckpt_name} TTA done')\n\npd.DataFrame({'id':test_ids,'genre':le.inverse_transform(ast_test.argmax(1))}).to_csv('submission_ast.csv',index=False)\nprint(f'✓ submission_ast.csv ({len(checkpoints_to_use)} checkpoints x 7-offset TTA)')\n","metadata":{},"outputs":[],"execution_count":null},{"id":"d047e0de-2729-420b-9534-4b0fcff8b121","cell_type":"markdown","source":"## 8. Confusion Matrix — Error Analysis","metadata":{}},{"id":"3a847c29-4820-4055-96bc-660efe86e3d4","cell_type":"code","source":"# Use CNN OOF for confusion matrix (has labels)\ncm = confusion_matrix(labs_all, cnn_oof.argmax(1))\nfig, ax = plt.subplots(figsize=(10,8))\nsns.heatmap(cm, annot=True, fmt='d', xticklabels=GENRES, yticklabels=GENRES,\n            cmap='Blues', ax=ax)\nax.set_title('CNN Confusion Matrix (OOF)', fontsize=13, fontweight='bold')\nax.set_xlabel('Predicted'); ax.set_ylabel('True')\nplt.tight_layout()\nplt.savefig('confusion_matrix.png', dpi=100, bbox_inches='tight')\nplt.show()\nprint('Confusion matrix saved ✓')","metadata":{},"outputs":[],"execution_count":null},{"id":"e3d206fa-0807-4c35-b117-89d2321689bc","cell_type":"markdown","source":"## 9. Ensemble — AST-weighted Final Submission","metadata":{}},{"id":"5cf7a095-7cb8-4dc5-9e79-41e01856b2e4","cell_type":"code","source":"print('OOF scores:')\nprint(f'  LGBM : {lgbm_oof_f1:.4f}')\nprint(f'  CNN  : {cnn_oof_f1:.4f}')\nprint(f'  CRNN : {crnn_oof_f1:.4f}')\nprint(f'  AST  : {best_af:.4f}')\n\nraw       = ast_test.copy()\npred_freq = raw.mean(axis=0)\n\nprint('\\nRaw predicted frequencies:')\nfor g, f in zip(GENRES, pred_freq):\n    print(f'  {g:12s}: {f:.4f}  (expected 0.1000)')\n\n# Auto-select best correction combo\nraw_probs = ast_test.copy()\nbest_corrected = None\nbest_balance = float('inf')\nbest_power = None\n\nfor temp, power in [(1.2, 1.3), (1.5, 1.5), (1.3, 1.4), (1.0, 1.2)]:\n    raw_t = raw_probs ** (1.0 / temp)\n    raw_t = raw_t / raw_t.sum(axis=1, keepdims=True)\n    pred_f = raw_t.mean(axis=0)\n    corr = raw_t / (pred_f ** power + 1e-8)\n    corr = corr / corr.sum(axis=1, keepdims=True)\n    balance = corr.mean(axis=0).std()\n    print(f'  temp={temp} p={power}: std={balance:.4f}  max/min={corr.mean(0).max()/corr.mean(0).min():.2f}x')\n    if balance < best_balance:\n        best_balance = balance\n        best_corrected = corr\n        best_power = (temp, power)\n\ncorrected = best_corrected\nprint(f'\\nBest: temp={best_power[0]} p={best_power[1]}')\nprint('After best correction:')\nfor g, f in zip(GENRES, corrected.mean(axis=0)):\n    print(f'  {g:12s}: {f:.4f}')\n\nfinal = pd.DataFrame({'id': test_ids, 'genre': le.inverse_transform(corrected.argmax(1))})\nfinal.to_csv('submission.csv', index=False)\nprint('\\n✅ submission.csv saved ← SUBMIT THIS')\nprint(final['genre'].value_counts().to_string())\nassert final['genre'].nunique() == 10, 'ERROR: not all 10 genres!'\nassert final['genre'].value_counts().max() < 650, 'ERROR: overcorrected!'\nassert final['genre'].value_counts().min() > 100, 'ERROR: undercorrected!'\nprint('Sanity check PASSED ✓')\nfinal.head(10)\n","metadata":{},"outputs":[],"execution_count":null},{"id":"676abd16-0ab5-43f8-bd7f-6ae7db9fad34","cell_type":"code","source":"print('Done ✓')","metadata":{},"outputs":[],"execution_count":null}]}