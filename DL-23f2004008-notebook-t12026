e(np.float32)\n\ndef compute_mel(y):\n    m = librosa.feature.melspectrogram(y=y,sr=SR,n_mels=N_MELS,\n                                        hop_length=HOP_LENGTH,n_fft=N_FFT,fmax=FMAX)\n    m = librosa.power_to_db(m, ref=np.max)\n    return ((m-m.mean())/(m.std()+1e-6)).astype(np.float32)\n\ndef spec_augment(mel, fmask=20, tmask=80, n=2):\n    mel = mel.copy()\n    for _ in range(n):\n        f=random.randint(0,fmask); f0=random.randint(0,max(0,N_MELS-f))\n        mel[f0:f0+f,:]=0\n        t=random.randint(0,tmask); t0=random.randint(0,max(0,mel.shape[1]-t))\n        mel[:,t0:t0+t]=0\n    return mel\n\naugment_wav = Compose([\n    AddGaussianNoise(min_amplitude=0.001,max_amplitude=0.03,p=0.5),\n    TimeStretch(min_rate=0.85,max_rate=1.15,p=0.4),\n    PitchShift(min_semitones=-2,max_semitones=2,p=0.3),\n    Shift(min_shift=-0.2,max_shift=0.2,p=0.3),\n],p=0.85)\n\ndef get_cached_mel(fp):\n    key  = Path(fp).parent.name+'_'+Path(fp).stem\n    path = MEL_CACHE/f'{key}.npy'\n    if path.exists(): return np.load(path)\n    y = load_audio(fp)\n    m = compute_mel(y)\n    np.save(path,m)\n    return m\n\nprint('Utilities ready ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-09T11:35:26.165910Z","iopub.execute_input":"2026-03-09T11:35:26.166220Z","iopub.status.idle":"2026-03-09T11:35:26.176367Z","shell.execute_reply.started":"2026-03-09T11:35:26.166196Z","shell.execute_reply":"2026-03-09T11:35:26.175461Z"}},"outputs":[{"name":"stdout","text":"Utilities ready ✓\n","output_type":"stream"}],"execution_count":17},{"id":"97575e27-62e9-4bcd-9ffd-b597c55db71e","cell_type":"code","source":"print('Caching train mels...')\nfor fp in tqdm(df_train['filepath']):\n    try: get_cached_mel(fp)\n    except: pass\n\nprint('Caching test mels...')\nfor fp in tqdm(test_files):\n    try: get_cached_mel(fp)\n    except: pass\n\nprint('All mels cached ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-09T11:35:26.177425Z","iopub.execute_input":"