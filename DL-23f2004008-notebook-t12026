    "    def __len__(self): return len(self.folders)\n",
    "    def _fix(self,m):\n",
    "        T=m.shape[1]\n",
    "        if T<FIXED_FRAMES: m=np.pad(m,((0,0),(0,FIXED_FRAMES-T)),mode='wrap')\n",
    "        elif T>FIXED_FRAMES:\n",
    "            s=random.randint(0,T-FIXED_FRAMES) if self.augment else (T-FIXED_FRAMES)//2\n",
    "            m=m[:,s:s+FIXED_FRAMES]\n",
    "        return m\n",
    "    def __getitem__(self,i):\n",
    "        try: m=get_mel_train(self.folders[i])\n",
    "        except: m=np.zeros((N_MELS,FIXED_FRAMES),dtype=np.float32)\n",
    "        m=self._fix(m)\n",
    "        if self.augment: m=spec_augment(m)\n",
    "        m=torch.tensor(m,dtype=torch.float32).unsqueeze(0)\n",
    "        if self.labels is not None:\n",
    "            return m,torch.tensor(self.labels[i],dtype=torch.long)\n",
    "        return m\n",
    "\n",
    "class TestMelDataset(Dataset):\n",
    "    def __init__(self,fps):\n",
    "        self.fps=list(fps)\n",
    "    def __len__(self): return len(self.fps)\n",
    "    def _fix(self,m):\n",
    "        T=m.shape[1]\n",
    "        if T<FIXED_FRAMES: m=np.pad(m,((0,0),(0,FIXED_FRAMES-T)),mode='wrap')\n",
    "        elif T>FIXED_FRAMES: m=m[:,(T-FIXED_FRAMES)//2:(T-FIXED_FRAMES)//2+FIXED_FRAMES]\n",
    "        return m\n",
    "    def __getitem__(self,i):\n",
