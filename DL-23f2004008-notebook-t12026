    "        return torch.tensor(self._fix(m),dtype=torch.float32).unsqueeze(0)\n",
    "\n",
    "class ResBlock(nn.Module):\n",
    "    def __init__(self,ic,oc,s=1):\n",
    "        super().__init__()\n",
    "        self.c=nn.Sequential(\n",
    "            nn.Conv2d(ic,oc,3,stride=s,padding=1,bias=False),nn.BatchNorm2d(oc),nn.ReLU(True),\n",
    "            nn.Conv2d(oc,oc,3,padding=1,bias=False),nn.BatchNorm2d(oc))\n",
    "        self.sk=nn.Sequential() if (s==1 and ic==oc) else nn.Sequential(\n",
    "            nn.Conv2d(ic,oc,1,stride=s,bias=False),nn.BatchNorm2d(oc))\n",
    "        self.r=nn.ReLU(True)\n",
    "    def forward(self,x): return self.r(self.c(x)+self.sk(x))\n",
