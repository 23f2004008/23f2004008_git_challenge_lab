    "class CRNN(nn.Module):\n",
    "    def __init__(self,nc=NUM_CLASSES,rh=128,dr=0.3):\n",
    "        super().__init__()\n",
    "        self.cnn=nn.Sequential(\n",
    "            nn.Conv2d(1,16,3,padding=1,bias=False),nn.BatchNorm2d(16),nn.ELU(),nn.MaxPool2d((2,2)),\n",
    "            nn.Conv2d(16,32,3,padding=1,bias=False),nn.BatchNorm2d(32),nn.ELU(),nn.MaxPool2d((2,2)),\n",
    "            nn.Conv2d(32,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)),\n",
    "            nn.Conv2d(64,64,3,padding=1,bias=False),nn.BatchNorm2d(64),nn.ELU(),nn.MaxPool2d((2,2)))\n",
    "        self.gru=nn.GRU(64*(N_MELS//16),rh,1,batch_first=True,bidirectional=True,dropout=0.)\n",
    "        self.attn=nn.Linear(rh*2,1)\n",
    "        self.head=nn.Sequential(nn.Dropout(dr),nn.Linear(rh*2,nc))\n",
    "    def forward(self,x):\n",
    "        x=self.cnn(x); B,C,H,W=x.shape\n",
    "        x=x.permute(0,3,1,2).reshape(B,W,C*H)\n",
    "        x,_=self.gru(x)\n",
    "        w=torch.softmax(self.attn(x),dim=1)\n",
    "        return self.head((x*w).sum(1))\n",
    "\n",
    "with torch.no_grad():\n",
    "    o=CRNN()(torch.randn(2,1,N_MELS,FIXED_FRAMES))\n",
    "print(f'CRNN output:{o.shape}  Params:{sum(p.numel() for p in CRNN().parameters()):,}')"
