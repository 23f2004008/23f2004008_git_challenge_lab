   m=torch.tensor(m,dtype=torch.float32).unsqueeze(0)\n        if self.labels is not None:\n            return m, torch.tensor(self.labels[i],dtype=torch.long)\n        return m\n\nclass ResBlock(nn.Module):\n    def __init__(self,ic,oc,s=1):\n        super().__init__()\n        self.c=nn.Sequential(\n            nn.Conv2d(ic,oc,3,stride=s,padding=1,bias=False),nn.BatchNorm2d(oc),nn.ReLU(True),\n            nn.Conv2d(oc,oc,3,padding=1,bias=False),nn.BatchNorm2d(oc))\n        self.sk=nn.Sequential() if (s==1 and ic==oc) else nn.Sequential(\n            nn.Conv2d(ic,oc,1,stride=s,bias=False),nn.BatchNorm2d(oc))\n        self.r=nn.ReLU(True)\n    def forward(self,x): return self.r(self.c(x)+self.sk(x))\n\nclass MelCNN(nn.Module):\n    def __init__(self,nc=NUM_CLASSES,dr=0.4):\n        super().__init__()\n        self.net=nn.Sequential(\n            nn.Conv2d(1,32,7,stride=2,padding=3,bias=False),nn.BatchNorm2d(32),nn.ReLU(True),\n            nn.MaxPool2d(3,stride=2,padding=1),\n            ResBlock(32,64),ResBlock(64,64),\n            ResBlock(64,128,2),ResBlock(128,128),\n            ResBlock(128,256,2),ResBlock(256,256),\n            ResBlock(256,512,2),ResBlock(512,512),\n            nn.AdaptiveAvgPool2d((1,1)))\n        self.head=nn.Sequential(\n            nn.Flatten(),nn.Dropout(dr),\n            nn.Linear(512,256),nn.ReLU(True),\n            nn.Dropout(dr*0.5),nn.Linear(256,nc))\n    def forward(self,x): return self.head(self.net(x))\n\nwith torch.no_grad():\n    o=MelCNN()(torch.randn(2,1,N_MELS,FIXED_FRAMES))\nprint(f'CNN output:{o.shape}  Params:{sum(p.numel() for p in MelCNN().parameters()):,}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-09T11:38:25.612641Z","iopub.execute_input":"2026-03-09T11:38:25.612990Z","iopub.status.idle":"2026-03-09T11:38:26.116448Z","shell.execute_reply.started":"2026-03-09T11:38:25.612969Z","shell.execute_reply":"2026-03-09T11:38:26.115608Z"}},"outputs":[{"name":"stdout","text":"CNN output:torch.Size([2, 10])  Params:11,286,250\n","output_type":"stream"}],"execution_count":23},{"id":"d25e5d4d-57a3-40ec-b019-70fe8f4e0e25","cell_type":"code","source":"def train_ep(model,loader,opt,crit):\n    model.train()\n    ls,ps,ts=0.,[],[]\n    for m,l in loader:\n        m,l=m.to(DEVICE),l.to(DEVICE)\n        opt.zero_grad()\n        o=model(m); loss=crit(o,l)\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(),1.0)\n        opt.step()\n        ls+=loss.item()*len(l)\n        ps.extend(o.detach().argmax(1).cpu().numpy())\n        ts.extend(l.cpu().numpy())\n    return ls/len(loader.dataset), f1_score(ts,ps,average='macro')\n\n@torch.no_grad()\ndef val_ep(model,loader,crit):\n    model.eval()\n    ls,ps,ts,pr=0.,[],[],[]\n    for m,l in loader:\n        m,l=m.to(DEVICE),l.to(DEVICE)\n        o=model(m)\n        ls+=crit(o,l).item()*len(l)\n        p=F.softmax(o,1).cpu().numpy()\n        pr.extend(p); ps.extend(p.argmax(1)); ts.extend(l.cpu().numpy())\n    return ls/len(loader.dataset), f1_score(ts,ps,average='macro'), np.array(pr)\n\n@torch.no_grad()\ndef get_probs(model,loader):\n    model.eval()\n    out=[]\n    for b in loader:\n        m=(b[0] if isinstance(b,(list,tuple)) else b).to(DEVICE)\n        out.append(F.softmax(model(m),1).cpu().numpy())\n    return np.concatenate(out,0)\n\nprint('Helpers ready ✓')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-09T11:38:26.117426Z","iopub.execute_input":"2026-03-09T11:38:26.117699Z","iopub.status.idle":"2026-03-09T11:38:26.126895Z","shell.execute_reply.started":"2026-03-09T11:38:26.117679Z","shell.execute_reply":"2026-03-09T11:38:26.126344Z"}},"outputs":[{"name":"stdout","text":"Helpers ready ✓\n","output_type":"stream"}],"execution_count":24},{"id":"29f709e9-406a-42a6-99d4-9df7547acc12","cell_type":"code","source":"fps_all  = df_train['filepath'].values\nlabs_all = le.transform(df_train['genre'].values)\nskf      = StratifiedKFold(n_splits=N_FOLDS,shuffle=True,random_state=SEED)\ncnn_oof  = np.zeros((len(fps_all),NUM_CLASSES))\ncnn_test = np.zeros((len(test_files),NUM_CLASSES))\nNW = 4\n\ncnn_fold_scores = []\n\nfor fold,(tri,vali) in enumerate(skf.split(fps_all,labs_all)):\n    print(f'\\n━━━ CNN Fold {fold+1}/{N_FOLDS} ━━━')\n\n    trl=DataLoader(MelDataset(fps_all[tri], labs_all[tri], True), BATCH_SIZE,shuffle=True, num_workers=NW,pin_memory=True)\n    vll=DataLoader(MelDataset(fps_all[vali],labs_all[vali],False),BATCH_SIZE,shuffle=False,num_workers=NW,pin_memory=True)\n    tsl=DataLoader(MelDataset(test_files,augment=False),          BATCH_SIZE,shuffle=False,num_workers=NW)\n\n    model=MelCNN().to(DEVICE)\n    opt  =torch.optim.AdamW(model.parameters(),lr=LR,weight_decay=1e-4)\n    sch  =torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(opt,T_0=10,T_mult=2)\n    crit =nn.CrossEntropyLoss(label_smoothing=0.1)\n\n    best_f1,best_st,pat=0.,None,0\n    for ep in range(EPOCHS_CNN):\n        tl,tf=train_ep(model,trl,opt,crit)\n        vl,vf,_=val_ep(model,vll,crit)\n        sch.step()\n        if vf>best_f1: best_f1=vf; best_st={k:v.cpu().clone() for k,v in model.state_dict().items()}; pat=0\n        else: pat+=1\n        if (ep+1)%5==0: print(f'  ep{ep+1}: tf={tf:.3f} vf={vf:.3f} best={best_f1:.3f}')\n        if pat>=10: print(f'  early stop ep{ep+1}'); break\n\n    model.load_state_dict(best_st); model.to(DEVICE)\n    _,_,pr=val_ep(model,vll,crit)\n    cnn_oof[vali]=pr\n    cnn_test+=get_probs(model,tsl)/N_FOLDS\n    cnn_fold_scores.append(best_f1)\n    print(f'  ✓ Fold {fold+1} best F1: {best_f1:.4f}')\n    del model; gc.collect(); torch.cuda.empty_cache()\n\ncnn_oof_f1=f1_score(labs_all,cnn_oof.argmax(1),average='macro')\nprint(f'\\n✅ CNN OOF F1: {cnn_oof_f1:.4f}  |  Fold scores: {[f\"{s:.4f}\" for s in cnn_fold_scores]}')\npd.DataFrame({'id':test_ids,'genre':le.inverse_transform(cnn_test.argmax(1))}).to_csv('submission_cnn.csv',index=False)\nprint('✓ submission_cnn.csv saved')","metadata":{"trusted":true,"execution":{"iopub.statu