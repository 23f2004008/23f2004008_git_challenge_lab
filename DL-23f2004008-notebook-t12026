    "# Phase 1: freeze backbone, train head only\n",
    "for n,p in ast.named_parameters():\n",
    "    p.requires_grad = ('classifier' in n or 'layernorm' in n)\n",
    "\n",
    "crit_ast = nn.CrossEntropyLoss(label_smoothing=0.05)\n",
    "opt_ast  = torch.optim.AdamW(\n",
    "    filter(lambda p: p.requires_grad, ast.parameters()), lr=1e-4, weight_decay=1e-4)\n",
    "\n",
    "best_af, best_ast_st, ast_scores = 0., None, []\n",
    "\n",
    "for ep in range(EPOCHS_AST):\n",
    "    # Unfreeze all at epoch 3\n",
    "    if ep == 3:\n",
    "        print('🔓 Unfreezing all layers...')\n",
    "        for p in ast.parameters(): p.requires_grad = True\n",
    "        opt_ast = torch.optim.AdamW([\n",
    "            {'params': ast.audio_spectrogram_transformer.parameters(), 'lr': 2e-5},\n",
    "            {'params': ast.classifier.parameters(), 'lr': 1e-4}\n",
    "        ], weight_decay=1e-4)\n",
    "\n",
    "    ast.train(); tp, tt = [], []\n",
    "    for b in tqdm(atrl, desc=f'AST ep{ep+1}', leave=False):\n",
    "        iv = b['input_values'].to(DEVICE)\n",
    "        lb = b['labels'].to(DEVICE)\n",
    "        opt_ast.zero_grad()\n",
    "        logits = ast(input_values=iv).logits\n",
    "        crit_ast(logits, lb).backward()\n",
    "        torch.nn.utils.clip_grad_norm_(ast.parameters(), 1.0)\n",
    "        opt_ast.step()\n",
    "        tp.extend(logits.detach().argmax(1).cpu().numpy())\n",
    "        tt.extend(lb.cpu().numpy())\n",
    "    tf = f1_score(tt, tp, average='macro')\n",
    "\n",
    "    ast.eval(); vp, vt = [], []\n",
    "    with torch.no_grad():\n",
    "        for b in avll:\n",
    "            iv = b['input_values'].to(DEVICE)\n",
    "            vp.extend(ast(input_values=iv).logits.argmax(1).cpu().numpy())\n",
    "            vt.extend(b['labels'].numpy())\n",
    "    vf = f1_score(vt, vp, average='macro')\n",
    "    ast_scores.append(vf)\n",
    "    print(f'ep{ep+1}: train_f1={tf:.4f}  val_f1={vf:.4f}')\n",
    "    if vf > best_af:\n",
    "        best_af = vf\n",
    "        best_ast_st = {k: v.cpu().clone() for k, v in ast.state_dict().items()}\n",
    "\n",
    "print(f'\\n✅ Best AST val F1: {best_af:.4f}')"
